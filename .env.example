# Copy to .env and fill in. Never commit .env — only this file with placeholders.

# PostgreSQL (docker compose)
POSTGRES_USER=navbat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=navbat

# Telegram bot token from @BotFather (placeholder below is not a real token)
BOT_TOKEN=123456789:replace-with-your-bot-token
BOT_USERNAME=your_bot
# true = the bot worker logs messages instead of calling Telegram (handy without a real token)
BOT_DRY_RUN=true

# Public HTTPS URL of the Mini App (set it in @BotFather → Bot Settings → Menu Button / Web App)
WEBAPP_URL=http://localhost:8080
BUSINESS_SLUG=demo

# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-32-plus-random-characters

# Seed "Demo Barbershop" on first start
SEED_DEMO=true
# Accept "Authorization: dev <telegramId>" for local testing (ignored when NODE_ENV=production)
AUTH_DEV_MODE=false

# Prepayment providers (optional). Leave empty to disable. Use sandbox/test credentials only.
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
STARS_ENABLED=false
