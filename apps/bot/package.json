{
  "name": "@navbat/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "grammY Telegram bot: commands, inline actions and the notification worker.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --external:pg-native --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@navbat/core": "*",
    "@navbat/db": "*",
    "grammy": "^1.38.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  }
}
