{
  "name": "navbat",
  "private": true,
  "version": "0.1.0",
  "description": "Appointment booking for barbershops, salons, clinics and car services in Uzbekistan: Telegram bot + Mini App + admin panel.",
  "license": "MIT",
  "author": "xoliddev",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @navbat/api",
    "dev:bot": "npm run dev -w @navbat/bot",
    "dev:web": "npm run dev -w @navbat/web",
    "build:demo": "npm run build:demo -w @navbat/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project db --project bot",
    "test:api": "vitest run --project api",
    "test:e2e": "npm run test:e2e -w @navbat/web",
    "db:migrate": "npm run migrate -w @navbat/api",
    "db:seed": "npm run seed -w @navbat/api"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
